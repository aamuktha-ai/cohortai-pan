# Provide one approved source for the current PAN data dictionary. Do not commit the file or credentials.
PAN_REFERENCE_PATH=/secure/path/PAN_Data_Dictionary.csv
# PAN_REFERENCE_URL=https://approved-pan-source.example.org/PAN_Data_Dictionary.csv

# Record the release shown in CohortAI-PAN reports.
PAN_REFERENCE_VERSION=PAN-release-id
PAN_REFERENCE_RELEASE_DATE=YYYY-MM-DD
PAN_REFERENCE_SOURCE_LABEL=Precision Aging Network approved data dictionary
PAN_REFERENCE_CACHE_MINUTES=60

# Optional HTTPS form or ticket URL shown in reports for corrections and concerns.
COHORTAI_FEEDBACK_URL=https://approved-uacc-feedback.example.org/cohortai

# Local development binds to 127.0.0.1. Production should sit behind UACC authentication and HTTPS.
PORT=5180
HOST=127.0.0.1
